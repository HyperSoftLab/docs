# При TTL_UI_ENABLED=true переменные ниже перестают переутверждать сроки
# существующих таблиц на каждом старте — иначе рестарт откатывал бы правки из
# интерфейса. При создании новой таблицы они по-прежнему срабатывают.

# APM
# AGENTS_TTL_DAY=30
# ANALYTIC_EVENT_DATA_TTL_DAY=30
# CUSTOM_EVENT_DATA_TTL_DAY=30
# ERROR_DATA_TTL_DAY=30
# ERROR_EVENT_DATA_TTL_DAY=30
# METRIC_DATA_TTL_DAY=30
# SQL_TRACE_DATA_TTL_DAY=30
# TRANSACTION_SAMPLE_DATA_TTL_DAY=8
# LOG_EVENT_DATA_TTL_DAY=1
# APP_DEPENDENCIES_TTL_DAY=366

# Распределённая трассировка: spans, traces_v2, trace_id_ts_idx
# SPAN_EVENT_DATA_TTL_DAY=8

# Browser RUM
# BROWSER_DEFAULT_EVENTS_TTL_DAY=8
# BROWSER_JSERRORS_TTL_DAY=8
# BROWSER_ROOT_TTL_DAY=8
# BROWSER_INSIGHTS_TTL_DAY=2
# BROWSER_RESOURCES_TTL_DAY=2
# BROWSER_LOGS_TTL_DAY=1
# Если не задана, берётся значение BROWSER_DEFAULT_EVENTS_TTL_DAY
# BROWSER_TIMING_EVENTS_TTL_DAY=8

# Инфраструктура, OTLP, 1С, мобильный мониторинг, инциденты
# INFRA_METRICS_EVENTS_TTL_DAY=30
# OTEL_METRICS_TTL_DAY=30
# ONE_C_TECH_LOG_EVENTS_TTL_DAY=30
# INCIDENTS_TTL_DAY=30
# DEV_MOB_TTL_DAY=1

# Статистика группировки URL
# SEGMENT_STATS_DAYS=3
